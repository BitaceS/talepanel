# ─────────────────────────────────────────────────────────────────────────────
# TalePanel — Daemon Host Environment
# Populated by scripts/install-daemon.sh after redeeming an enrollment token.
# ─────────────────────────────────────────────────────────────────────────────

# Panel URL the daemon heartbeats to.  Example: https://panel.example.com
TALEDAEMON_API_URL=CHANGEME_GENERATED_BY_INSTALLER

# UUID and bearer token returned by POST /api/v1/nodes/enroll.
TALEDAEMON_NODE_ID=CHANGEME_GENERATED_BY_INSTALLER
TALEDAEMON_NODE_TOKEN=CHANGEME_GENERATED_BY_INSTALLER

# Skip TLS cert verification when calling the panel.  Only set to 1 when
# the panel uses a self-signed cert (--no-domain installs).  Anything other
# than 1/true is treated as false.
# TALEDAEMON_INSECURE_TLS=0

# The panel reaches this node only over mutual TLS (default since v0.14): the
# daemon refuses plaintext and exits if it cannot obtain its node certificate.
# Only for a panel older than v0.12, which cannot speak mTLS: set
# TALEDAEMON_REQUIRE_MTLS=0 and TALEDAEMON_ALLOW_LEGACY_BEARER=1.
# TALEDAEMON_REQUIRE_MTLS=1
# TALEDAEMON_ALLOW_LEGACY_BEARER=0

# Node key/cert/CA directory. Empty = /srv/taledaemon/pki.
# TALEDAEMON_PKI_DIR=

# Per-server isolation: every game server runs under its own Linux user, so a
# server cannot read the node token, the TLS key or other servers' files.
# auto (default) = on when the daemon runs as root and the data directory keeps
# file owners; uid = required (refuse to start otherwise); off = all servers run
# as the daemon's user (not recommended).
# TALEDAEMON_SERVER_ISOLATION=auto
# First UID handed to game servers (one per server, counting up, never reused).
# TALEDAEMON_SERVER_UID_BASE=2000000

# Server sandbox on top of isolation: a system call filter (no ptrace, mount,
# namespaces, bpf, io_uring, kernel modules, ...) and network rules (servers
# reach the internet and their players, but not the daemon's port, other
# servers or anything else on this node), plus memory and task limits where
# cgroups allow. The network rules need the NET_ADMIN capability (set in
# docker-compose.yml). auto (default) = what works, the rest is logged;
# strict = refuse to start unless filter and network rules are active;
# off = none of it (not recommended).
# TALEDAEMON_SERVER_SANDBOX=auto
